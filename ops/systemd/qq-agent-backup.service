[Unit]
# 数据目录每周备份（由 qq-agent-backup.timer 触发，见同目录 .timer）。
# 安装：
#   1) 把 backup-qq-agent-data.sh 放到仓库里的 ops/（或任意固定路径）
#   2) cp ops/systemd/qq-agent-backup.service ~/.config/systemd/user/
#   3) 按实际部署位置改下面 ExecStart 与 Environment（%h = 用户 home 目录）
#   4) systemctl --user daemon-reload && systemctl --user enable --now qq-agent-backup.timer
Description=QQ Agent data weekly backup

[Service]
Type=oneshot
ExecStart=%h/qq-agent/ops/backup-qq-agent-data.sh
# 默认部署根目录 /data/qq-agent，备份输出到 $HOME/qq-agent-backups，保留 4 份：
# Environment=QQ_AGENT_DIR=/data/qq-agent
# Environment=QQ_AGENT_BACKUP_DIR=%h/qq-agent-backups
# Environment=QQ_AGENT_SERVICE=qq-agent-linux.service
# Environment=QQ_AGENT_KEEP=4
